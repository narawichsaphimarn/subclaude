# Comma-separated list of API keys this proxy accepts on x-api-key /
# Authorization: Bearer. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_API_KEYS=changeme-generate-a-real-key

# Host/port the FastAPI server binds to.
HOST=127.0.0.1
PORT=8000

# Used when a request omits `model` (real Anthropic SDK clients always send it).
DEFAULT_MODEL=claude-opus-4-8

# How many concurrent `claude` CLI subprocesses may run at once. Start low --
# subscription-tier concurrency limits under OAuth auth are undocumented, so
# tune this up only after observing real behavior.
MAX_CONCURRENT_REQUESTS=2

# Seconds a request may wait for a free concurrency slot before getting 429.
QUEUE_TIMEOUT_S=30

# Seconds a single `claude` CLI call may run before it's aborted as a timeout.
REQUEST_TIMEOUT_S=120

# "synthetic" (implemented, v1 default) | "passthrough" (stretch goal, not
# implemented yet -- see README known gaps).
STREAMING_MODE=synthetic

# Where the caller-label -> session-uuid mapping is stored, and the fixed
# working directory every session-bound request shares. SESSION_CWD must NOT
# change across restarts of a long-lived deployment -- doing so silently
# orphans every existing session (see README known gaps).
SESSION_STORE_PATH=~/.subclaude/sessions.json
SESSION_CWD=~/.subclaude/session-cwd
